{
  "name": "@john/presets",
  "version": "1.9.0",
  "description": "Shared tooling presets for personal projects: TypeScript, oxlint (+ anti-slop), oxfmt, editorconfig, gitattributes, fallow",
  "keywords": [
    "anti-slop",
    "editorconfig",
    "fallow",
    "oxfmt",
    "oxlint",
    "presets",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "tsconfig.base.json",
    "tsconfig.bun.json",
    "tsconfig.react.json",
    ".oxlintrc.json",
    "oxlint.react.json",
    "tools/oxlint/anti-slop",
    "oxfmtrc.json",
    "fallow.base.json",
    "editorconfig.ini",
    "gitattributes.txt",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.bun.json": "./tsconfig.bun.json",
    "./tsconfig.react.json": "./tsconfig.react.json",
    "./.oxlintrc.json": "./.oxlintrc.json",
    "./oxlint.react.json": "./oxlint.react.json",
    "./oxlint/anti-slop": "./tools/oxlint/anti-slop/index.mjs",
    "./oxlint/anti-slop/*": "./tools/oxlint/anti-slop/*",
    "./oxfmtrc.json": "./oxfmtrc.json",
    "./fallow.base.json": "./fallow.base.json",
    "./editorconfig.ini": "./editorconfig.ini",
    "./gitattributes.txt": "./gitattributes.txt",
    "./package.json": "./package.json"
  },
  "scripts": {
    "sync:anti-slop": "p presets sync --anti-slop --no-dotfiles --force",
    "format": "oxfmt --threads=4 --config oxfmtrc.json .",
    "format:check": "oxfmt --threads=4 --check --config oxfmtrc.json .",
    "check:config": "oxlint --print-config -c .oxlintrc.json > /dev/null && oxlint --print-config -c oxlint.react.json > /dev/null",
    "check": "bun run sync:anti-slop && bun run format:check && bun run check:config"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "1.4.0",
    "fallow": "3.18.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@oxlint/plugins": "1.80.0",
    "fallow": "3.18.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@oxlint/plugins": {
      "optional": false
    },
    "fallow": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
